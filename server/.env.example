# Generate a long, random value for local development and never commit your real .env file.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional: enables LLM insights. Without it the deterministic fallback is used.
GROQ_API_KEY=
# Required only while running init_admin.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-development-password
